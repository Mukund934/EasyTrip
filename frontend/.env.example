# EasyTrip — frontend environment template
#
# Copy this file to frontend/.env.local and replace every placeholder:
#     cp frontend/.env.example frontend/.env.local
#
# !! EVERY NEXT_PUBLIC_* VALUE IS INLINED INTO THE JAVASCRIPT BUNDLE SENT TO THE
# !! BROWSER. Anyone can read them with devtools. Never put a secret, private
# !! key, database password or API secret behind a NEXT_PUBLIC_ prefix. The
# !! Firebase web values below are public identifiers by design — access is
# !! controlled by Firebase security rules and by the backend's token
# !! verification, not by keeping them hidden. Server-only secrets belong in
# !! backend/.env.
#
# Vars marked REQUIRED must be set for the app to work. OPTIONAL vars have a
# working default in code.

# -----------------------------------------------------------------------------
# Backend API
# -----------------------------------------------------------------------------

# REQUIRED — base URL of the Express backend, including the /api suffix.
# Some call sites fall back to http://localhost:5000/api, but the service layer
# (services/adminService.js, authService.js) does not — leave this unset and
# those requests hit "undefined/...". A single client with one URL convention is
# IMP-072.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# -----------------------------------------------------------------------------
# Public site origin (SEO — IMP-113)
# -----------------------------------------------------------------------------

# OPTIONAL, but the SEO features are inert without it. The scheme and host this
# deployment is served from, with no trailing path:
#
#     NEXT_PUBLIC_SITE_URL=https://easytrip.example
#
# Three things need an absolute URL and cannot compute one: the `Sitemap:` line
# in /robots.txt, every <loc> in /sitemap.xml, and the canonical / og:url tags
# on a place page.
#
# Leave it unset and each of those degrades explicitly rather than guessing:
# robots.txt ships without a Sitemap line, /sitemap.xml returns 404, and the
# canonical tags are not emitted. That is deliberate — a canonical pointing at
# the wrong host de-indexes the page, so a wrong value is worse than none.
#
# It is NOT derived from the request's Host header, which the client chooses:
# building crawler-facing URLs from it is host-header injection that persists
# into somebody's index. See frontend/src/services/siteUrl.js.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OPTIONAL, server-only. Overrides the value above on the Next server, and is
# read at runtime rather than inlined at build time — so one built artifact can
# serve a preview deployment and production. Same pattern as API_URL.
# SITE_URL=https://easytrip.example

# -----------------------------------------------------------------------------
# Firebase Web SDK (client-side sign-in)
#
# Where to get these: Firebase console -> Project settings -> General -> "Your
# apps" -> Web app -> SDK setup and configuration -> Config. Copy each field of
# the firebaseConfig object into the matching var below.
# -----------------------------------------------------------------------------

# REQUIRED — firebaseConfig.apiKey. A public project identifier, not a secret.
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key

# REQUIRED — firebaseConfig.authDomain, used by the sign-in redirect flow.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com

# REQUIRED — firebaseConfig.projectId. Must match backend FIREBASE_PROJECT_ID,
# or the ID tokens this app mints will fail server-side verification.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id

# REQUIRED — firebaseConfig.storageBucket.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com

# REQUIRED — firebaseConfig.messagingSenderId.
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000

# REQUIRED — firebaseConfig.appId.
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# OPTIONAL — firebaseConfig.measurementId. Only needed for Google Analytics.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# -----------------------------------------------------------------------------
# Set automatically — do not add to your .env.local
# -----------------------------------------------------------------------------
#
# NODE_ENV is set by Next.js itself ("development" for `next dev`, "production"
# for `next build`/`next start`). Setting it by hand here will not take effect.
